# Copy to .env.local — it is gitignored and auto-loaded by Next and by the db:* scripts.
# Leave unset for local dev — PGlite runs embedded and persists to .data/
# Set to a Neon connection string for production (Vercel)
DATABASE_URL=

# Used by the orchestrator (optional; deterministic fallback works without any key)
# Provider precedence: ANTHROPIC_API_KEY wins over GOOGLE_GENERATIVE_AI_API_KEY
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-3.5-flash
# Optional: let the LLM also write the itinerary (slow on free-tier quotas)
# LLM_SYNTHESIS=1
