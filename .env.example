# Copy to .env.local — it is gitignored and auto-loaded by Next and by the db:* scripts.
# Leave unset for local dev — PGlite runs embedded and persists to .data/
# Set to a Neon connection string for production (Vercel)
DATABASE_URL=

# Used by the orchestrator (optional; deterministic fallback works without it)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
